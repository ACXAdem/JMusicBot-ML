<!-- author: Kaidan Gustave -->
<configuration>
    <property name="logDir" value="./logs/"/>
    <property name="fileName" value="JMusicBotJP"/>
    <appender name="Simple" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <!-- Pattern -->
            <pattern>
                %nopex[%d{HH:mm:ss}] [%level] [%logger{0}]: %msg%n%ex
            </pattern>
        </encoder>
    </appender>
    <appender name="File" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${logDir}${fileName}.log</file>
        <!-- Log files: a new file every day (or when it exceeds 10 MB); old ones are compressed.
             Files older than 7 days and anything over 100 MB in total are deleted automatically. -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${logDir}${fileName}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>

        <encoder>
            <charset>UTF-8</charset>
            <pattern>
                %nopex[%d{HH:mm:ss}] [%level] [%logger{0}]: %msg%n%ex
            </pattern>
        </encoder>
    </appender>

    <!-- Quiet down noisy library logs (huge JSON dumps, stack traces, lines repeated every 10 minutes).
         PlayerManager already writes a short summary. -->
    <logger name="dev.lavalink.youtube.clients.skeleton.StreamingNonMusicClient" level="ERROR"/>
    <logger name="dev.lavalink.youtube.clients.skeleton.NonMusicClient" level="ERROR"/>
    <logger name="dev.lavalink.youtube.http.YoutubeAccessTokenTracker" level="WARN"/>
    <logger name="com.sedmelluq.discord.lavaplayer.track.playback.LocalAudioTrackExecutor" level="ERROR"/>
    <logger name="com.sedmelluq.discord.lavaplayer.natives" level="WARN"/>
    <logger name="com.sedmelluq.lava.common.natives" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="Simple"/>
        <appender-ref ref="File"/>
    </root>
    <!--<root level="DEBUG">
        <appender-ref ref="Simple"/>
        <appender-ref ref="File"/>
    </root>-->
    <!--
        <root level="TRACE">
            <appender-ref ref="Simple"/>
            <appender-ref ref="File"/>
        </root>
    -->
    </configuration>
